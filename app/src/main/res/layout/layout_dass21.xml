<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llDASS21Result"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardview_mainscore2"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="16dp"
        android:elevation="5dp"
        app:cardBackgroundColor="#4EC6DE"
        app:strokeWidth="1dp"
        app:strokeColor="@color/white"
        app:cardCornerRadius="@dimen/margin_card_16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/main_score_title2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Depression"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/main_score_level2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mild"
                    android:textColor="#06142E"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_main_score2"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/circle_shape"
                    android:backgroundTint="@color/white"
                    android:gravity="center"
                    android:text="7"
                    android:textColor="#06142E"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="15dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:src="@drawable/next_arrow_settings" />
        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardview_mainscore"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="-22dp"
        android:elevation="5dp"
        android:layout_below="@id/cardview_mainscore2"
        app:cardBackgroundColor="#4EC6DE"
        app:cardCornerRadius="@dimen/margin_card_16dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/white">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/main_score_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Depression"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/main_score_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mild"
                    android:textColor="#06142E"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_main_score"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/circle_shape"
                    android:backgroundTint="@color/white"
                    android:gravity="center"
                    android:text="7"
                    android:textColor="#06142E"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="15dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:src="@drawable/next_arrow_settings" />
        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardview_mainscore3"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="-18dp"
        android:elevation="5dp"
        android:layout_below="@id/cardview_mainscore"
        app:cardBackgroundColor="#4EC6DE"
        app:cardCornerRadius="@dimen/margin_card_16dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/white">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/main_score_title3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Depression"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/main_score_level3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mild"
                    android:textColor="#06142E"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_main_score3"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/circle_shape"
                    android:backgroundTint="@color/white"
                    android:gravity="center"
                    android:text="7"
                    android:textColor="#06142E"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="15dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:src="@drawable/next_arrow_settings" />
        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>

</LinearLayout>